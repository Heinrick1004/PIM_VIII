FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/TaskFlow.Web/TaskFlow.Web.csproj
RUN dotnet publish src/TaskFlow.Web/TaskFlow.Web.csproj -c Release --no-restore -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out .
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
USER app
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 CMD curl --fail --silent http://127.0.0.1:8080/Account/Login || exit 1
ENTRYPOINT ["dotnet", "TaskFlow.Web.dll"]
