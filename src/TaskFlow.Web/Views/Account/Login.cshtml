@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Entrar";
}
<a class="brand auth-brand" asp-controller="Account" asp-action="Login">
    <span class="brand-mark" aria-hidden="true">T</span>
    <span>task<span>flow</span><small>ALUNOS TECH</small></span>
</a>
<div class="auth-intro">
    <p class="eyebrow">BEM-VINDO DE VOLTA</p>
    <h1>Seu trabalho, em fluxo.</h1>
    <p>Acesse seu espaço para acompanhar tarefas e prioridades da equipe.</p>
</div>
<form asp-controller="Account" asp-action="Login" method="post" class="form-stack" data-loading-form>
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <div class="field">
        <label asp-for="Email">E-mail</label>
        <input asp-for="Email" type="email" autocomplete="username" placeholder="voce@alunostech.com" autofocus />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="Password">Senha</label>
        <input asp-for="Password" autocomplete="current-password" placeholder="Sua senha" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>
    <button class="button button-primary button-wide" type="submit" data-loading-button>
        <span data-button-label>Entrar</span>
        <span class="loading-spinner" aria-hidden="true" hidden></span>
        <span aria-hidden="true">→</span>
    </button>
</form>
<p class="auth-footnote">Acesso restrito a usuários cadastrados pela administração.</p>
